FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json tsconfig.json ./
COPY apps/web apps/web
COPY packages packages
RUN npm ci && npm run build -w @learnsphere/web

FROM node:20-alpine
WORKDIR /app
COPY --from=build /app .
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "-w", "@learnsphere/web"]
